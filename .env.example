# PEYVA runtime configuration. Copy to .env (git-ignored) and fill in. Bun loads .env automatically.
# Any OpenAI-compatible Chat Completions endpoint with tool calling works, for example:
#   OpenAI      PEYVA_LLM_BASE_URL=https://api.openai.com/v1
#   OpenRouter  PEYVA_LLM_BASE_URL=https://openrouter.ai/api/v1
#   Gemini      PEYVA_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   Local       PEYVA_LLM_BASE_URL=http://localhost:11434/v1   (Ollama; the model must support tools)
PEYVA_LLM_BASE_URL=
PEYVA_LLM_API_KEY=
# Required: a model that supports tool/function calling and handles Persian well.
PEYVA_LLM_MODEL=
# Optional
PEYVA_LLM_TIMEOUT_MS=45000
