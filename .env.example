# PEYVA runtime configuration. Copy to .env (git-ignored) and fill in. Bun loads .env automatically.
# Any OpenAI-compatible Chat Completions endpoint with tool calling works, for example:
#   OpenAI      PEYVA_LLM_BASE_URL=https://api.openai.com/v1
#   OpenRouter  PEYVA_LLM_BASE_URL=https://openrouter.ai/api/v1
#   Gemini      PEYVA_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   Local       PEYVA_LLM_BASE_URL=http://localhost:11434/v1   (Ollama; the model must support tools)
PEYVA_LLM_BASE_URL=
PEYVA_LLM_API_KEY=
# Required: a model that supports tool/function calling and handles Persian well.
PEYVA_LLM_MODEL=
# Optional
PEYVA_LLM_TIMEOUT_MS=45000

# ---------- Phase 3: memory, monitoring goals, notifications ----------
# PostgreSQL. Easiest: `bun run db:start` (embedded PostgreSQL in ./.pgdata, no Docker) prints this URL.
PEYVA_DATABASE_URL=
# Optional: port for `bun run db:start` (default 54329).
PEYVA_EMBEDDED_PG_PORT=54329
# Single-user educational mode: there is no login; every row belongs to this id. Never expose PEYVA publicly.
PEYVA_USER_ID=local
# Worker: hours between two checks of the same goal (default 6, minimum 6) and how often it looks for due goals.
PEYVA_MONITOR_INTERVAL_HOURS=6
PEYVA_WORKER_POLL_SECONDS=60
# Development simulation ONLY (never against a live provider for long): allow intervals under 6 hours.
# PEYVA_DEV_ALLOW_SHORT_INTERVAL=1
# PEYVA_DEV_INTERVAL_MINUTES=10
# Optional Telegram alerts (official Bot API). Create a bot with @BotFather; then link from PEYVA with
# `/telegram link` + `/telegram verify`. The token is a secret: keep it only here.
TELEGRAM_BOT_TOKEN=
