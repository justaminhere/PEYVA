{
  "name": "peyva",
  "private": true,
  "type": "module",
  "scripts": {
    "peyva:chat": "bun run src/cli/chat.ts",
    "peyva:tools-check": "bun run src/cli/tools-check.ts",
    "test": "bun test ./test && bun run test:ui",
    "test:all": "bun run test && cd experiments/travel-mcp-spike && bun run test",
    "typecheck": "experiments/travel-mcp-spike/node_modules/.bin/tsc -p . && experiments/travel-mcp-spike/node_modules/.bin/tsc -p web && cd experiments/travel-mcp-spike && ./node_modules/.bin/tsc -p .",
    "peyva:token-budget": "bun run src/cli/token-budget.ts",
    "db:start": "bun run src/cli/db.ts start",
    "db:migrate": "bun run src/cli/db.ts migrate",
    "db:generate": "drizzle-kit generate",
    "peyva:worker": "bun run src/cli/worker.ts",
    "peyva:goals": "bun run src/cli/goals.ts",
    "test:ui": "bun test --preload ./web/test/setup.ts ./web/test",
    "web:build": "bun --bun vite build --config web/vite.config.ts",
    "web:dev": "bun --bun vite --config web/vite.config.ts",
    "peyva:web": "bun run src/web/server.ts",
    "peyva:llm-check": "bun run src/cli/llm-check.ts"
  },
  "dependencies": {
    "@fontsource/lalezar": "5.3.0",
    "@fontsource/vazirmatn": "5.3.0",
    "drizzle-orm": "0.45.4",
    "embedded-postgres": "18.7.0-beta.19",
    "hono": "4.13.19",
    "openai": "7.62.0",
    "postgres": "4.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "21.0.4",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "drizzle-kit": "0.31.11",
    "happy-dom": "21.0.4",
    "tailwindcss": "4.3.5",
    "vite": "8.3.8"
  }
}
